{
  "id": "claude-code",
  "name": "Claude Code",
  "version": "0.1.2",
  "format": "json",
  "configFile": ".mcp.json",
  "auth": "environment",
  "transport": "http",
  "skill": true,
  "minimumDocumentedVersion": null,
  "realClientTested": false,
  "sources": [
    "https://code.claude.com/docs/en/mcp"
  ],
  "setup": "https://mcp.yqstai.cn/setup?host=claude-code",
  "instructions": [
    "设置本机 INT_AI_API_KEY 环境变量。",
    "合并到项目 .mcp.json；确认项目信任与工具审批。",
    "重新打开客户端，在 /mcp 检查工具。"
  ],
  "config": {
    "mcpServers": {
      "int-ai": {
        "type": "http",
        "url": "https://mcp.yqstai.cn/mcp",
        "headers": {
          "Authorization": "Bearer ${INT_AI_API_KEY}"
        }
      }
    }
  }
}
