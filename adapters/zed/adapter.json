{
  "id": "zed",
  "name": "Zed",
  "version": "0.1.2",
  "format": "json",
  "configFile": "Zed settings.json",
  "auth": "manual-secret",
  "transport": "streamable-http",
  "skill": false,
  "minimumDocumentedVersion": null,
  "realClientTested": false,
  "sources": [
    "https://zed.dev/docs/ai/mcp"
  ],
  "setup": "https://mcp.yqstai.cn/setup?host=zed",
  "instructions": [
    "进入配置向导获取 Key。",
    "在用户私有 settings.json 的 context_servers 合并配置并替换占位符。",
    "在 Agent 面板检查 int-ai 工具；不要提交含 Key 的配置。"
  ],
  "config": {
    "context_servers": {
      "int-ai": {
        "url": "https://mcp.yqstai.cn/mcp",
        "headers": {
          "Authorization": "Bearer REPLACE_LOCALLY_WITH_KEY"
        }
      }
    }
  }
}
