{
  "id": "gemini-cli",
  "name": "Gemini CLI",
  "version": "0.1.3",
  "format": "json",
  "configFile": "~/.gemini/settings.json",
  "auth": "manual-secret",
  "transport": "streamable-http",
  "skill": true,
  "minimumDocumentedVersion": null,
  "realClientTested": false,
  "sources": [
    "https://geminicli.com/docs/tools/mcp-server/"
  ],
  "setup": "https://mcp.yqstai.cn/setup?host=gemini-cli",
  "instructions": [
    "在客户端私有配置中替换占位符；不要将含 Key 的配置提交到 Git。",
    "合并到 ~/.gemini/settings.json 的 mcpServers。",
    "重启 Gemini CLI 并检查 MCP 工具状态。"
  ],
  "config": {
    "mcpServers": {
      "int-ai": {
        "httpUrl": "https://mcp.yqstai.cn/mcp",
        "headers": {
          "Authorization": "Bearer REPLACE_LOCALLY_WITH_KEY"
        }
      }
    }
  },
  "skillVersion": "0.1.4"
}
