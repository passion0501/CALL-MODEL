{
  "id": "windsurf",
  "name": "Windsurf",
  "version": "0.1.3",
  "format": "json",
  "configFile": "~/.codeium/windsurf/mcp_config.json",
  "auth": "environment",
  "transport": "streamable-http",
  "skill": false,
  "minimumDocumentedVersion": null,
  "realClientTested": false,
  "sources": [
    "https://docs.devin.ai/desktop/cascade/mcp"
  ],
  "setup": "https://mcp.yqstai.cn/setup?host=windsurf",
  "instructions": [
    "设置 INT_AI_API_KEY 环境变量。",
    "通过 MCP 设置打开配置文件，合并 int-ai。",
    "完全重启客户端，确认工具列表。"
  ],
  "config": {
    "mcpServers": {
      "int-ai": {
        "serverUrl": "https://mcp.yqstai.cn/mcp",
        "headers": {
          "Authorization": "Bearer ${env:INT_AI_API_KEY}"
        }
      }
    }
  },
  "skillVersion": "0.1.4"
}
