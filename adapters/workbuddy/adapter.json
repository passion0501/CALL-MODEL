{
  "id": "workbuddy",
  "name": "WorkBuddy",
  "version": "0.1.4",
  "format": "json",
  "configFile": "connector/mcp.json",
  "auth": "native-form",
  "transport": "streamableHttp",
  "skill": true,
  "minimumDocumentedVersion": "4.24.0",
  "realClientTested": false,
  "sources": [
    "https://open.workbuddy.cn/docs/connector"
  ],
  "setup": "https://mcp.yqstai.cn/setup?host=workbuddy",
  "instructions": [
    "使用 WorkBuddy 原生 Key 密码表单；获取说明链接提供注册、充值和创建 Key 路径，不是自定义内嵌页面。",
    "安装连接器包装需要客户端支持或平台接入；尚未完成市场上架，不承诺按名称安装。",
    "提交密码表单后检查连接和工具发现；本包装使用的中英文示例字段要求 4.24.0，尚待实机验收。"
  ],
  "config": {
    "mcpServers": {
      "int-ai": {
        "type": "streamableHttp",
        "url": "https://mcp.yqstai.cn/mcp",
        "headers": {
          "Authorization": "Bearer ${INT_AI_API_KEY}"
        },
        "timeout": 120000
      }
    }
  },
  "skillVersion": "0.1.4"
}
